# Database — set this to your local PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: real Stripe TEST MODE key (sk_test_...). Leave empty to use the
# built-in sandbox simulator (test card 4242 4242 4242 4242 approves,
# 4000 0000 0000 0002 declines).
STRIPE_SECRET_KEY=
